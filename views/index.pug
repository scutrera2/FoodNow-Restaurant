extends layout

block header
  .intro
    .pilots
      h1 Great food, delivered fast
      h2 FoodNow is the world’s leading food delivery platform. #[br] Join our elite team of delivery partners and help people receive food faster than ever.
      if pilot && pilot.stripeAccountId
        a.button.primary(href='/pilots/dashboard') View dashboard
      else
        a.button.primary(href='/pilots/signup') Become a delivery partner

block content
  .features
    section.schedule
      h3 Deliver when you want
      p You can be a part of the FoodNow team anytime—you pick your own schedule. Fly as little or as much as you want.
    section.earnings
      h3 Earn more with each delivery
      p Delivery fees increase with time and distance. Cash out whenever you want and get instant transfers to your account.
    section.app
      h3 Track every delivery
      p Real-time GPS tracking, route optimization, and 24/7 support.

block footer
  .annotation.landing
    a.stripe(href='https://stripe.com') Stripe
    p Rocket Deliveries is a #[a(href='https://stripe.com/connect') Stripe Connect] and #[a(href='https://stripe.com/connect/custom') Custom] demo. It is not a real product.
    a.github.arrow(href='https://github.com/stripe/stripe-connect-custom-rocketdeliveries') View on GitHub
